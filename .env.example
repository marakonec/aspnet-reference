# Скопіювати у файл .env (він не потрапляє в Git) і за потреби змінити порти.

APP_IMG_DASHBOARD=mcr.microsoft.com/aspire/dashboard:13.6.2
APP_IMG_SPECTRAL=stoplight/spectral:6.16
APP_IMG_OASDIFF=tufin/oasdiff:v1.31.0
APP_IMG_DB=postgres:18.6
APP_IMG_IDP=quay.io/keycloak/keycloak:26.8.1
APP_IMG_K6=grafana/k6:2.2.0
APP_IMG_APP=ghcr.io/change-me/app-api:change-me

APP_PORT_DEPLOY_API=15190
APP_PORT_NOTIFIER=15110
APP_PORT_DB=15200
APP_PORT_IDP=15300
APP_PORT_DASH_UI=18888
APP_PORT_DASH_OTLP_GRPC=18889
APP_PORT_DASH_OTLP_HTTP=18890

APP_DB_NAME=app
APP_DB_USER=app
APP_DB_PASSWORD=app-local-only
APP_IDP_ADMIN=admin
APP_IDP_ADMIN_PASSWORD=admin-local-only
