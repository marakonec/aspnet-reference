    },
    "App.Api (Production)": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "http://localhost:15100",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production"
      }
    }
  }
