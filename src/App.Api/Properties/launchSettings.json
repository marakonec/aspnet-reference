    "App.Api": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "http://localhost:15100",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "App.Api (memory)": {
      "commandName": "Project",
      "launchBrowser": false,
      "applicationUrl": "http://localhost:15100",
